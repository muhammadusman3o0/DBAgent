# Environment template for DBAgent (postgres-mcp)
# Copy this file to .env and fill in your real values.

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Database Type Selection
DB_TYPE=postgres
# Supported types: postgres, mysql, sqlite

# Option 1: Single DATABASE_URL (preferred for PostgreSQL/MySQL)
# PostgreSQL: postgres://user:password@host:port/database
# MySQL: mysql://user:password@host:port/database
DATABASE_URL=

# Option 2: Individual Database Connection Settings
# Used when DATABASE_URL is not set

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=myapp
MYSQL_USER=root
MYSQL_PASSWORD=

# SQLite Configuration
SQLITE_FILE=./database.sqlite

# Generic Database Settings (works for any type)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# ============================================================
# LLM PROVIDER CONFIGURATION
# ============================================================
# Choose ONE provider by setting LLM_PROVIDER and configuring its specific settings below.
# Supported providers: openai, azure, grok, gemini, ollama

# LLM Provider Selection
LLM_PROVIDER=openai

# ============================================================
# OPENAI CONFIGURATION
# ============================================================
# Standard OpenAI API (api.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
# Optional: Custom OpenAI-compatible base URL
#OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# AZURE OPENAI CONFIGURATION
# ============================================================
# Azure OpenAI Service
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Example: https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_NAME=
# The deployment name you created in Azure (e.g., gpt-4, gpt-35-turbo)
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# API version to use

# ============================================================
# GROK CONFIGURATION (xAI)
# ============================================================
# Grok API (x.ai)
GROK_API_KEY=
GROK_MODEL=grok-beta
# Available models: grok-beta, grok-vision-beta
GROK_BASE_URL=https://api.x.ai/v1

# ============================================================
# GEMINI CONFIGURATION (Google AI)
# ============================================================
# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
# Available models: gemini-pro, gemini-pro-vision, gemini-1.5-pro, gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================================
# OLLAMA CONFIGURATION (Local/Self-hosted)
# ============================================================
# Ollama for local LLM inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
# Available models depend on what you've pulled: llama2, mistral, codellama, phi, etc.
# Run `ollama list` to see installed models

# ============================================================
# ADVANCED LLM SETTINGS (Optional)
# ============================================================
# These settings apply across all providers (where supported)
LLM_TEMPERATURE=0.1
# Creativity level (0.0 - 2.0). Lower = more deterministic
LLM_MAX_TOKENS=2000
# Maximum tokens in response
LLM_TOP_P=0.95
# Nucleus sampling parameter
#LLM_TIMEOUT=60000
# Request timeout in milliseconds

# ============================================================
# RUNTIME CONFIGURATION (Optional)
# ============================================================
#NODE_ENV=development
#PORT=3000
#LOG_LEVEL=info

# Web Chatbot Configuration
WEB_PORT=3000
# Port for the web-based chatbot interface (default: 3000)

# ============================================================
# NOTES
# ============================================================
# Database:
# - Scripts in `scripts/` (mcp-agent, mcp-smoke) require DATABASE_URL
# - If DATABASE_URL is set, it takes precedence over individual POSTGRES_* variables
#
# LLM Providers:
# - Only one provider is active at a time (set via LLM_PROVIDER)
# - OpenAI: Standard ChatGPT API (requires paid API key)
# - Azure OpenAI: Enterprise Azure deployment
# - Grok: xAI's Grok model (requires xAI API access)
# - Gemini: Google's Gemini models (free tier available)
# - Ollama: Local/self-hosted models (free, runs on your machine)
#
# Security:
# - Never commit .env files to version control
# - Keep API keys and passwords secret
# - Use .env.example as a template only
