{
  "name": "dbagent",
  "version": "2.0.0",
  "description": "Multi-database LLM query system with MCP support - intelligent natural language queries for PostgreSQL, MySQL, and SQLite",
  "type": "module",
  "bin": {
    "dbagent": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('./build/index.js', '755')\"",
    "dev": "npm run build && npx tsx scripts/interactive-client.ts",
    "start": "npm run build && node build/index.js",
    "test": "vitest",
    "test:ci": "vitest run",
    "watch": "tsc --watch",
    "test:interactive": "npm run build && npx tsx scripts/interactive-client.ts",
    "test:mcp-agent": "npm run build && npx tsx scripts/mcp-agent.ts",
    "web": "npm run build && npx tsx scripts/web-chatbot-simple.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgresql",
    "mysql",
    "sqlite",
    "database",
    "llm",
    "openai",
    "gemini",
    "ollama",
    "natural-language",
    "sql",
    "query",
    "chatbot",
    "ai",
    "multi-database"
  ],
  "author": "DBAgent Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/DBAgent.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/DBAgent/issues"
  },
  "homepage": "https://github.com/your-org/DBAgent#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "mysql2": "^3.15.3",
    "openai": "^4.0.0",
    "pg": "^8.13.1",
    "pino": "^9.3.2",
    "socket.io": "^4.8.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  },
  "files": [
    "build"
  ]
}

